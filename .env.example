# Database Selection
# SQLite (Recommended for Single User):
# Use an ABSOLUTE path (sqlite:////abs/path/to/grocery.db) — relative paths
# resolve against the CWD and create stray empty DBs when run from elsewhere.
# Leave unset to have the app write one automatically on first start.
# DATABASE_URL=sqlite:////home/you/grocery-tracker/grocery.db

# PostgreSQL (Recommended for Bulk Loader / Multi-User):
# DATABASE_URL=postgresql://grocery:grocery123@localhost:5433/grocery_tracker

# ── OCR Backend Switch ────────────────────────────────────────────────────
# 'local'      = LLaVA via Ollama or LM Studio (zero API cost, fully private)
# 'gemini'     = Google Gemini API (higher quality, requires API key)
# 'openrouter' = OpenRouter free-tier models (no payment method needed)
OCR_BACKEND=gemini

# Local backend settings (used when OCR_BACKEND=local)
OCR_BACKEND_URL=http://localhost:11434/v1
OCR_MODEL=granite3.3-vision:2b

# Images are downscaled before being sent to a local model. Lower these if
# your GPU runs out of memory; raise them for small print on long receipts.
# LOCAL_OCR_MAX_HEIGHT=1600
# LOCAL_OCR_JPEG_QUALITY=85

# Gemini settings (only needed when OCR_BACKEND=gemini)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash

# ── OpenRouter connector (only needed when OCR_BACKEND=openrouter) ────────
# Runs receipts through your own OpenRouter account on a model you choose.
# Key from https://openrouter.ai/keys — an account is required, a payment
# method is not. Full details in the OpenRouter section of README.md.
# OPENROUTER_API_KEY=your_key_here
#
# No default model — pick one deliberately; most are billed and most cannot
# read images. Any model accepting image input works.
# OCR_MODEL=qwen/qwen-2.5-vl-72b-instruct
#
# ⚠ PRIVACY: receipts — store, items, prices, dates — leave this machine.
# Requests carry provider.data_collection=deny, so OpenRouter refuses
# providers that retain or train on inputs, enforced server-side rather than
# depending on your account settings. For fully private OCR use
# OCR_BACKEND=local.
#
# ⚠ Measured 2026-08-17: EVERY ':free' model 404s under that deny policy —
# "No endpoints found matching your data policy (Free model training)". Free
# models are free *because* the provider may train on the inputs, so free and
# private are mutually exclusive here. To use them anyway, opt in knowingly:
# OPENROUTER_ALLOW_TRAINING=1
#
# A model without the ':free' suffix is refused unless this is set; the
# startup menu sets it for you when you type a paid model ID.
# OPENROUTER_ALLOW_PAID=1
#
# Only if you proxy OpenRouter. OCR_BACKEND_URL is ignored by this backend —
# it points at your local Ollama/LM Studio.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Nutrition Enrichment ──────────────────────────────────────────────────
# USDA FoodData Central key, used to auto-fill nutrition facts and brands.
# Free from https://fdc.nal.usda.gov/api-key-signup.html
# Optional — leave unset and nutrition lookups are skipped (logs a warning);
# everything else works. See /help/api-keys in the running app.
# FDC_API_KEY=your_fdc_key_here

# ── Auto-Ingest (folder watch) ────────────────────────────────────────────
# Receipts dropped in the inbox are processed automatically on a poll loop.
# The inbox is created on startup; it defaults to data/inbox at the project
# root and is gitignored, since anything dropped there is personal.
# FOLDER_WATCH=0            disable the watcher entirely (default: enabled)
# WATCH_FOLDER=/abs/path    watch somewhere other than data/inbox

# ── Feature Flags ─────────────────────────────────────────────────────────
# ENABLE_INGREDIENT_ANALYTICS=true    ingredient-level breakdowns (default: true)
# ENABLE_BULK_AUTO_PROCESS=true       auto-process bulk uploads (default: true)
# ENABLE_OPEN_PRODUCE=false           OpenFoodFacts produce lookups (default: false)
# ENABLE_EXPERIMENTAL_OCR=false       in-progress OCR paths (default: false)

# ── Database Migrations ───────────────────────────────────────────────────
# Alembic migrations run automatically at startup. Set to 0 to manage the
# schema yourself with `alembic upgrade head` (default: 1).
# AUTO_MIGRATE=1

# Security
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECRET_KEY=generate_a_long_random_string_here
